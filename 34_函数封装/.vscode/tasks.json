{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "编译当前工程",
            "type": "shell",
            "command": "g++",
            "args": [
                "${workspaceFolder}/*.cpp",
                "-o",
                "${workspaceFolder}/main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "自动收集当前文件夹所有 .cpp 编译为 main.exe"
        }
    ]
}